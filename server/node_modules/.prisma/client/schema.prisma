generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================
// ENUMS
// =====================

enum Role {
  SUPER_ADMIN
  CAMPAIGN_ADMIN
  CAMPAIGN_MANAGER
  REGIONAL_COORD
  CONSTITUENCY_COORD
  TEAM_LEADER
  VOLUNTEER
  CANDIDATE
  FINANCE_OFFICER
  AUDITOR
  ORGANIZATION
}

enum AccountType {
  CANDIDATE
  MANAGER
  ORGANIZATION
  TEAM
  VOLUNTEER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// =====================
// USER + REGISTRATION
// =====================

model User {
  id               String      @id @default(cuid())
  userId           String      @unique
  fullName         String
  email            String      @unique
  password         String
  phone            String      @unique
  county           String      @default("Nairobi")
  organization     String?
  organizationName String?
  accountType      AccountType @default(CANDIDATE)
  role             Role        @default(VOLUNTEER)
  status           UserStatus  @default(PENDING)
  isApproved       Boolean     @default(false)
  approvedBy       String?
  approvedAt       DateTime?

  organisationId   String?
  campaignId       String?
  candidateId      String?
  geographicUnitId String?
  mfaEnabled       Boolean @default(false)

  photo             String?
  bio               String?
  location          String?
  timezone          String? @default("Africa/Nairobi")
  emergencyContact  String?
  emergencyPhone    String?
  skills            String?
  languages         String?
  certifications    String?
  resumeUrl         String?
  portfolioLinks    String?
  workExperience    String?
  education         String?
  jobPreferences    String?
  jobTitle          String?
  department        String?
  workEmail         String?
  teamOverview      String?
  notificationPrefs String? @default("Email, WhatsApp")
  interests         String?
  availability      String?
  tshirtSize        String?
  idDocumentUrl     String?

  orgType        String?
  orgMission     String?
  orgWebsite     String?
  orgFoundedYear String?

  // ===== Online Mentions - Social Handles + Keywords + Verified Status =====
  // socialHandles: { youtube: "mckiplaa", x: "EvansForMCA", reddit: "mckiplaa" }
  // keywords: ["Evans Kiplangat", "Evans for MCA", "Bomet"]
  // verifiedStatuses: { youtube: "VERIFIED", x: "EXISTS", whatsapp: "alerts_only" }
  // Json? + no @default - SQLite + Prisma safe, old users get null = {}
  socialHandles    Json?
  keywords         Json?
  verifiedStatuses Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedCandidates Candidate[] @relation("ManagerCandidates")
  auditLogs         AuditLog[]  @relation("UserAuditLogs")
  eventsCreated     Event[]     @relation("UserEvents")
  sentMessages      Message[]   @relation("SentMessages")
  receivedMessages  Message[]   @relation("ReceivedMessages")
  mentionsCreated   Mention[]   @relation("UserMentions")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([accountType])
  @@index([status])
  @@index([county])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model GeographicUnit {
  id       String           @id @default(cuid())
  name     String
  type     String
  parentId String?
  parent   GeographicUnit?  @relation("GeoHierarchy", fields: [parentId], references: [id])
  children GeographicUnit[] @relation("GeoHierarchy")

  @@index([parentId])
  @@index([type])
}

model Candidate {
  id                   String     @id @default(cuid())
  candidateId          String     @unique
  fullName             String
  photo                String?
  phone                String
  email                String?
  party                String?
  positionContested    String
  county               String
  constituency         String
  ward                 String?
  biography            String?
  education            String?
  leadershipExperience String?
  status               String     @default("ACTIVE")
  assignedManagerId    String?
  assignedManager      User?      @relation("ManagerCandidates", fields: [assignedManagerId], references: [id])
  campaigns            Campaign[]

  // ===== Online Mentions - kept in sync with User by server/routes/social.js =====
  // social.js saves to BOTH User + Candidate so /api/me/overview can read from either
  socialHandles    Json?
  keywords         Json?
  verifiedStatuses Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedManagerId])
  @@index([county])
  @@index([constituency])
  @@index([email])
  @@index([fullName])
  @@index([status])
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  objectives  String?
  status      String    @default("PLANNING")
  teams       Team[]
  events      Event[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
  @@index([status])
}

model Team {
  id         String      @id @default(cuid())
  name       String
  campaignId String
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leaderId   String?
  volunteers Volunteer[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([campaignId])
}

model Volunteer {
  id               String   @id @default(cuid())
  fullName         String
  phone            String
  teamId           String?
  team             Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  onboardingStatus String   @default("PENDING")
  consentRecord    Boolean  @default(false)
  organization     String?
  county           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([teamId])
  @@index([onboardingStatus])
  @@index([organization])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  type        String    @default("RALLY")
  status      String    @default("UPCOMING")
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User      @relation("UserEvents", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([campaignId])
  @@index([createdById])
  @@index([date])
  @@index([status])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// =====================
// MENTION - ONLINE LISTENING / SOCIAL LISTENING
// =====================

model Mention {
  id String @id @default(cuid())

  // Legacy fields - kept for old rows
  candidate    String   @default("")
  organization String   @default("")
  authorHandle String   @default("")
  url          String   @default("")
  likes        Int      @default(0)
  shares       Int      @default(0)
  postedAt     DateTime @default(now())
  addedBy      String   @default("")
  addedById    String   @default("")
  status       String   @default("NEW")

  author        String  @default("Unknown")
  handle        String  @default("")
  // Clean platform: Facebook, Instagram, X, TikTok, YouTube, News, Reddit, Telegram, WhatsApp, Google
  // Do NOT store emoji - routes strip it. Old rows may have emoji, they still show.
  platform      String  @default("Facebook")
  text          String  @default("")
  link          String  @default("")
  sentiment     String  @default("NEUTRAL")
  candidateName String  @default("")
  orgName       String  @default("")
  county        String  @default("")
  sourceType    String  @default("MANUAL")
  isAuto        Boolean @default(false)

  // Fields used by server/routes/social.js - all optional, old rows get null
  // Without these, Prisma throws "Unknown argument"
  content       String?
  sourceUrl     String?
  source        String?
  candidateId   String?
  // NOTE: createdBy is a plain String (the user id as text), createdById is the FK relation.
  // social.js writes to BOTH so old + new queries work.
  createdBy     String?
  createdById   String?
  createdByUser User?   @relation("UserMentions", fields: [createdById], references: [id], onDelete: SetNull)

  externalId  String?
  authorId    String?
  mediaUrl    String?
  mentionedAt DateTime?
  intent      String    @default("OTHER")
  rawPayload  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, externalId])
  @@index([candidate])
  @@index([candidateName])
  @@index([organization])
  @@index([orgName])
  @@index([platform])
  @@index([sentiment])
  @@index([sourceType])
  @@index([postedAt])
  @@index([createdById])
  @@index([createdBy])
  @@index([externalId])
  @@index([intent])
  @@index([mentionedAt])
  @@index([status])
  @@index([isAuto])
  @@index([sourceUrl])
  @@index([candidateId])
  @@index([source])
}
